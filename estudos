
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
    char mensagem[1001];
    int contador = 0;

    printf("Escreva seu texto:\n");
    fgets(mensagem, sizeof(mensagem), stdin);

    int tamanho = strlen(mensagem);

    for (int i = 0; i < tamanho; i++) {
        if (mensagem[i] == ' ') {
            contador++;
        }
    }

    printf("Quantidade de espacos: %d", contador);

    return 0;
}
